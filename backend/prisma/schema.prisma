generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum AcademicStatus {
  ACTIVE
  INACTIVE
  GRADUATED
}

/// Estado guardado de una entrega. "Atrasada" y "sin entregar" se calculan con Assignment.dueAt.
enum SubmissionStatus {
  /// El alumno trabaja en ella (puede tener archivos) pero no la ha entregado.
  ASSIGNED
  /// Entregada; el docente puede calificarla.
  SUBMITTED
  /// Calificada y devuelta: el alumno ya ve su calificación.
  RETURNED
}

enum NotificationType {
  ASSIGNMENT_CREATED
  SUBMISSION_RETURNED
  POST_CREATED
  COMMENT_CREATED
  MATERIAL_CREATED
  RESOURCE_REVIEWED
  COURSE_ASSIGNED
  QUIZ_PUBLISHED
}

enum ResourceType {
  NOTE
  STUDY_GUIDE
  EXAM
  BOOK
  OTHER
}

/// Moderación del repositorio: lo que suben los alumnos espera aprobación.
enum ResourceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MaterialKind {
  FILE
  LINK
}

/// Cómo se divide el año escolar. Licenciaturas e ingenierías: cuatrimestres; bachillerato: semestres.
enum TermScheme {
  CUATRIMESTRAL
  SEMESTRAL
}

model Faculty {
  id        String     @id @default(uuid())
  name      String     @unique @map("nombre")
  code      String     @unique @map("clave")
  /// Tipo de periodo de todas sus carreras: decide en qué periodos se abren sus cursos.
  scheme    TermScheme @default(CUATRIMESTRAL) @map("tipo_periodo")
  careers   Career[]
  users     User[]
  createdAt DateTime   @default(now()) @map("creado_en")

  @@map("facultades")
}

model Career {
  id        String    @id @default(uuid())
  name      String    @map("nombre")
  code      String    @unique @map("clave")
  facultyId String    @map("facultad_id")
  faculty   Faculty   @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  subjects  Subject[]
  users     User[]
  courses   Course[]
  createdAt DateTime  @default(now()) @map("creado_en")

  @@index([facultyId])
  @@map("carreras")
}

model Subject {
  id          String       @id @default(uuid())
  name        String       @map("nombre")
  code        String       @unique @map("clave")
  /// Número de cuatrimestre o semestre, según el tipo de periodo de la facultad.
  semester    Int          @map("semestre")
  careerId    String       @map("carrera_id")
  career      Career       @relation(fields: [careerId], references: [id], onDelete: Cascade)
  courses     Course[]
  resources   Resource[]
  studyGroups StudyGroup[]

  @@index([careerId, semester])
  @@map("materias")
}

model User {
  id                 String             @id @default(uuid())
  /// Matrícula (alumnos) o número de empleado (docentes y administradores).
  /// La universidad no da correo a los alumnos: este es el identificador de acceso.
  username           String             @unique @map("usuario") @db.VarChar(30)
  passwordHash       String             @map("contrasena_hash")
  /// true tras un restablecimiento hecho por un administrador: debe cambiarla al entrar.
  mustChangePassword Boolean            @default(false) @map("debe_cambiar_contrasena")
  /// Va en cada token de sesión. Al subirla (desactivar cuenta, restablecer o cambiar
  /// contraseña) todas las sesiones abiertas dejan de valer.
  sessionVersion     Int                @default(0) @map("version_sesion")
  fullName           String             @map("nombre_completo")
  /// Ruta relativa dentro de storage/ (avatars/...).
  avatarUrl          String?            @map("ruta_avatar")
  role               UserRole           @map("rol")
  status             AcademicStatus     @default(ACTIVE) @map("estado")
  facultyId          String?            @map("facultad_id")
  careerId           String?            @map("carrera_id")
  faculty            Faculty?           @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  career             Career?            @relation(fields: [careerId], references: [id], onDelete: SetNull)
  taughtCourses      Course[]           @relation("TeacherCourses")
  enrollments        Enrollment[]
  posts              Post[]
  comments           Comment[]
  notifications      Notification[]
  assignments        Assignment[]       @relation("CreatedAssignments")
  submissions        Submission[]
  quizAttempts       QuizAttempt[]
  resources          Resource[]         @relation("ResourceAuthors")
  reviewedResources  Resource[]         @relation("ResourceReviewers")
  studyGroups        StudyGroup[]       @relation("GroupCreators")
  groupMemberships   StudyGroupMember[]
  materials          CourseMaterial[]
  createdAt          DateTime           @default(now()) @map("creado_en")
  updatedAt          DateTime           @updatedAt @map("actualizado_en")

  @@index([role, status])
  @@map("usuarios")
}

/// Periodo académico (cuatrimestre o semestre). Los cursos se ligan por la clave ("2026-C3").
model AcademicTerm {
  id        String     @id @default(uuid())
  code      String     @unique @map("clave")
  name      String     @map("nombre")
  /// Solo lo usan las facultades con el mismo tipo de periodo.
  scheme    TermScheme @default(CUATRIMESTRAL) @map("tipo")
  startsAt  DateTime?  @map("inicia_en") @db.Date
  endsAt    DateTime?  @map("termina_en") @db.Date
  /// Periodo que se propone por omisión al crear cursos. Solo uno a la vez por tipo.
  isCurrent Boolean    @default(false) @map("actual")
  /// Cerrado: ya no se crean cursos en él.
  closed    Boolean    @default(false) @map("cerrado")
  courses   Course[]
  createdAt DateTime   @default(now()) @map("creado_en")

  @@map("periodos")
}

model Course {
  id           String           @id @default(uuid())
  name         String           @map("nombre")
  /// Clave del periodo (AcademicTerm.code). Si se renombra la clave, se actualiza aquí.
  term         String           @map("periodo")
  academicTerm AcademicTerm     @relation(fields: [term], references: [code], onDelete: Restrict, onUpdate: Cascade)
  invitation   String           @unique @map("codigo_invitacion")
  /// Descripción de la clase (como en Classroom). Opcional.
  description  String?          @map("descripcion") @db.Text
  /// Aula: salón y horario, o enlace de la reunión en línea (texto libre del docente).
  meetingInfo  String?          @map("lugar_horario") @db.VarChar(200)
  /// Carrera de la clase (como en Classroom: nivel → carrera → cuatrimestre o semestre).
  careerId     String           @map("carrera_id")
  career       Career           @relation(fields: [careerId], references: [id], onDelete: Restrict)
  /// Número de cuatrimestre o semestre (según el tipo de periodo del nivel).
  grade        Int              @map("grado")
  /// Materia del catálogo. Opcional: la clase puede existir sin materia.
  subjectId    String?          @map("materia_id")
  teacherId    String           @map("docente_id")
  subject      Subject?         @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacher      User             @relation("TeacherCourses", fields: [teacherId], references: [id], onDelete: Restrict)
  enrollments  Enrollment[]
  posts        Post[]
  assignments  Assignment[]
  quizzes      Quiz[]
  topics       CourseTopic[]
  materials    CourseMaterial[]
  createdAt    DateTime         @default(now()) @map("creado_en")

  @@index([teacherId])
  @@index([subjectId])
  @@index([term])
  @@map("cursos")
}

model Enrollment {
  id        String   @id @default(uuid())
  courseId  String   @map("curso_id")
  studentId String   @map("alumno_id")
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now()) @map("inscrito_en")

  @@unique([courseId, studentId])
  @@map("inscripciones")
}

model Post {
  id        String    @id @default(uuid())
  content   String    @map("contenido") @db.Text
  courseId  String    @map("curso_id")
  authorId  String    @map("autor_id")
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]
  createdAt DateTime  @default(now()) @map("creado_en")

  @@index([courseId, createdAt])
  @@map("publicaciones")
}

model Comment {
  id        String   @id @default(uuid())
  content   String   @map("contenido") @db.Text
  postId    String   @map("publicacion_id")
  authorId  String   @map("autor_id")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("creado_en")

  @@index([postId, createdAt])
  @@map("comentarios")
}

model Assignment {
  id           String       @id @default(uuid())
  title        String       @map("titulo")
  instructions String       @map("instrucciones") @db.Text
  /// Sin fecha = se puede entregar cuando sea.
  dueAt        DateTime?    @map("fecha_limite")
  /// Puntaje máximo (la escala habitual es 10).
  points       Int          @default(10) @map("puntos")
  courseId     String       @map("curso_id")
  teacherId    String       @map("docente_id")
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher      User         @relation("CreatedAssignments", fields: [teacherId], references: [id], onDelete: Restrict)
  submissions  Submission[]
  createdAt    DateTime     @default(now()) @map("creado_en")
  updatedAt    DateTime     @updatedAt @map("actualizado_en")

  @@index([courseId, dueAt])
  @@map("tareas")
}

model Submission {
  id           String           @id @default(uuid())
  assignmentId String           @map("tarea_id")
  studentId    String           @map("alumno_id")
  status       SubmissionStatus @default(ASSIGNED) @map("estado")
  grade        Decimal?         @map("calificacion") @db.Decimal(5, 2)
  feedback     String?          @map("retroalimentacion") @db.Text
  submittedAt  DateTime?        @map("entregada_en")
  returnedAt   DateTime?        @map("devuelta_en")
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  files        SubmissionFile[]
  updatedAt    DateTime         @updatedAt @map("actualizado_en")

  @@unique([assignmentId, studentId])
  @@index([studentId, status])
  @@map("entregas")
}

/// Archivo adjunto a una entrega. fileUrl es la ruta relativa dentro de storage/.
model SubmissionFile {
  id           String     @id @default(uuid())
  submissionId String     @map("entrega_id")
  fileUrl      String     @unique @map("ruta_archivo")
  originalName String     @map("nombre_original")
  mimeType     String     @map("tipo_mime")
  size         Int        @map("tamano_bytes")
  sha256       String     @db.Char(64)
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("creado_en")

  @@index([submissionId])
  @@map("archivos_entrega")
}

/// Aviso dentro de la plataforma (no hay correo).
model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("usuario_id")
  type      NotificationType @map("tipo")
  title     String           @map("titulo")
  /// Ruta interna a la que lleva, p. ej. /cursos/<id>/tareas/<id>.
  link      String?          @map("enlace")
  readAt    DateTime?        @map("leida_en")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now()) @map("creado_en")

  @@index([userId, readAt, createdAt])
  @@map("notificaciones")
}

model Resource {
  id           String         @id @default(uuid())
  title        String         @map("titulo")
  description  String?        @map("descripcion") @db.Text
  type         ResourceType   @map("tipo")
  status       ResourceStatus @default(PENDING) @map("estado")
  /// Archivo subido (storage/repository/...) o, en su lugar, un enlace (p. ej. Google Drive).
  fileUrl      String?        @unique @map("ruta_archivo")
  originalName String?        @map("nombre_original")
  mimeType     String?        @map("tipo_mime")
  size         Int?           @map("tamano_bytes")
  sha256       String?        @db.Char(64)
  url          String?        @db.VarChar(500)
  subjectId    String         @map("materia_id")
  authorId     String         @map("autor_id")
  /// Motivo del rechazo (lo ve el autor).
  reviewNote   String?        @map("nota_revision") @db.VarChar(500)
  reviewedById String?        @map("revisado_por_id")
  reviewedAt   DateTime?      @map("revisado_en")
  subject      Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  author       User           @relation("ResourceAuthors", fields: [authorId], references: [id], onDelete: Cascade)
  reviewedBy   User?          @relation("ResourceReviewers", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now()) @map("creado_en")

  @@index([subjectId, type])
  @@index([status, createdAt])
  @@map("recursos")
}

/// Tema o unidad del curso para agrupar el material.
model CourseTopic {
  id        String           @id @default(uuid())
  courseId  String           @map("curso_id")
  title     String           @map("titulo") @db.VarChar(120)
  position  Int              @default(0) @map("posicion")
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  materials CourseMaterial[]
  createdAt DateTime         @default(now()) @map("creado_en")

  @@index([courseId, position])
  @@map("temas_curso")
}

/// Material del curso: un archivo (storage/classroom-drive/...) o un enlace.
model CourseMaterial {
  id           String       @id @default(uuid())
  courseId     String       @map("curso_id")
  topicId      String?      @map("tema_id")
  title        String       @map("titulo") @db.VarChar(150)
  description  String?      @map("descripcion") @db.Text
  kind         MaterialKind @map("tipo")
  fileUrl      String?      @unique @map("ruta_archivo")
  url          String?      @db.VarChar(500)
  originalName String?      @map("nombre_original")
  mimeType     String?      @map("tipo_mime")
  size         Int?         @map("tamano_bytes")
  sha256       String?      @db.Char(64)
  authorId     String       @map("autor_id")
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topic        CourseTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now()) @map("creado_en")

  @@index([courseId, topicId])
  @@map("materiales_curso")
}

model StudyGroup {
  id          String             @id @default(uuid())
  title       String             @map("titulo")
  description String             @map("descripcion") @db.Text
  capacity    Int                @map("cupo")
  /// Cuándo y dónde se reúnen, p. ej. "Martes 16:00, biblioteca".
  meetingInfo String?            @map("lugar_horario") @db.VarChar(200)
  subjectId   String?            @map("materia_id")
  creatorId   String             @map("creador_id")
  subject     Subject?           @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  creator     User               @relation("GroupCreators", fields: [creatorId], references: [id], onDelete: Cascade)
  members     StudyGroupMember[]
  createdAt   DateTime           @default(now()) @map("creado_en")

  @@index([subjectId])
  @@map("grupos_estudio")
}

model StudyGroupMember {
  groupId  String     @map("grupo_id")
  userId   String     @map("usuario_id")
  group    StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime   @default(now()) @map("unido_en")

  @@id([groupId, userId])
  @@index([userId])
  @@map("miembros_grupo_estudio")
}

// ───────────── Cuestionarios y encuestas (estilo Google Forms) ─────────────

/// Cuestionario calificado o encuesta sin respuestas correctas.
enum QuizKind {
  QUIZ
  SURVEY
}

/// Cuándo ve el alumno su resultado (solo cuestionarios calificados).
enum QuizResultsVisibility {
  ON_SUBMIT
  AFTER_CLOSE
  NEVER
}

enum QuizQuestionType {
  SINGLE
  MULTIPLE
  TRUE_FALSE
  SHORT
  PARAGRAPH
}

model Quiz {
  id                String                @id @default(uuid())
  courseId          String                @map("curso_id")
  course            Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title             String                @map("titulo") @db.VarChar(150)
  description       String?               @map("descripcion") @db.Text
  kind              QuizKind              @default(QUIZ) @map("tipo")
  /// Sin fecha = abierto desde que se publica / sin cierre.
  opensAt           DateTime?             @map("abre_en")
  closesAt          DateTime?             @map("cierra_en")
  /// Minutos para responder desde que el alumno empieza. Null = sin límite.
  timeLimitMinutes  Int?                  @map("limite_minutos")
  resultsVisibility QuizResultsVisibility @default(ON_SUBMIT) @map("ver_resultados")
  /// Borrador hasta que el docente lo publica; los alumnos solo ven los publicados.
  published         Boolean               @default(false) @map("publicado")
  publishedAt       DateTime?             @map("publicado_en")
  questions         QuizQuestion[]
  attempts          QuizAttempt[]
  createdAt         DateTime              @default(now()) @map("creado_en")
  updatedAt         DateTime              @updatedAt @map("actualizado_en")

  @@index([courseId, published])
  @@map("cuestionarios")
}

model QuizQuestion {
  id        String           @id @default(uuid())
  quizId    String           @map("cuestionario_id")
  quiz      Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  position  Int              @map("posicion")
  type      QuizQuestionType @map("tipo")
  prompt    String           @map("enunciado") @db.Text
  /// 0 en encuestas.
  points    Int              @default(1) @map("puntos")
  required  Boolean          @default(true) @map("obligatoria")
  /// Opciones [{ id, text }] (opción múltiple, casillas y verdadero/falso).
  options   Json?            @map("opciones")
  /// Respuesta correcta: { option } | { options: [] } | { accepted: [] }. Null en párrafo y encuestas.
  answerKey Json?            @map("respuesta_correcta")
  answers   QuizAnswer[]

  @@index([quizId, position])
  @@map("preguntas_cuestionario")
}

/// Un solo intento por alumno.
model QuizAttempt {
  id          String       @id @default(uuid())
  quizId      String       @map("cuestionario_id")
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId   String       @map("alumno_id")
  student     User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  startedAt   DateTime     @default(now()) @map("iniciado_en")
  /// Límite para enviar (tiempo límite o cierre, lo que llegue antes). Null = sin límite.
  deadlineAt  DateTime?    @map("vence_en")
  submittedAt DateTime?    @map("enviado_en")
  score       Decimal?     @map("puntaje") @db.Decimal(7, 2)
  maxScore    Int          @default(0) @map("puntaje_maximo")
  /// Hay respuestas de párrafo (o cortas sin clave) que el docente debe calificar.
  needsReview Boolean      @default(false) @map("por_revisar")
  answers     QuizAnswer[]

  @@unique([quizId, studentId])
  @@index([studentId])
  @@map("intentos_cuestionario")
}

model QuizAnswer {
  id         String       @id @default(uuid())
  attemptId  String       @map("intento_id")
  attempt    QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String       @map("pregunta_id")
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  /// { option } | { options: [] } | { text }
  value      Json         @map("valor")
  /// Null = pendiente de calificar a mano.
  points     Decimal?     @map("puntos") @db.Decimal(6, 2)

  @@unique([attemptId, questionId])
  @@index([questionId])
  @@map("respuestas_cuestionario")
}
