# ─────────────────────────────────────────────────────────────
# Plataforma UACH — variables de entorno
# Copia este archivo como .env y reemplaza TODOS los valores <...>
# ─────────────────────────────────────────────────────────────
NODE_ENV=development

# Puertos
PORT=4000
FRONTEND_PORT=3000
BACKEND_PORT=4000
NGINX_PORT=80

# MySQL (docker-compose usa estos valores para crear la base de datos)
MYSQL_DATABASE=uach_platform
MYSQL_USER=uach_app
MYSQL_PASSWORD=<cambiar-password-app>
MYSQL_ROOT_PASSWORD=<cambiar-password-root>
# Puerto del host para MySQL en Docker (usa 3307 si ya tienes un MySQL local en el 3306).
MYSQL_HOST_PORT=3306
# Desarrollo local (MySQL en tu equipo). En Docker, docker-compose la reemplaza.
DATABASE_URL=mysql://uach_app:<cambiar-password-app>@localhost:3306/uach_platform

# Redis
REDIS_URL=redis://localhost:6379

# Autenticación — JWT_SECRET: mínimo 32 caracteres aleatorios
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<generar-secreto-aleatorio-de-48-bytes>
# Cada token dura esto; mientras el usuario está activo se renueva solo.
JWT_EXPIRES_IN=8h
# Límite absoluto de una sesión, en días desde que se inició (luego hay que volver a entrar).
SESSION_MAX_DAYS=14
# true en producción con HTTPS
COOKIE_SECURE=false
# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:3000

# Archivos
# Vacío = ../storage relativo a backend/. En Docker: /app/storage
STORAGE_PATH=
# true cuando Nginx entrega los archivos (X-Accel-Redirect)
FILES_ACCEL_REDIRECT=false

# Frontend: URL interna del backend (SSR y proxy /api en desarrollo)
API_INTERNAL_URL=http://localhost:4000

# Seed: administrador inicial (npm run prisma:seed)
# Número de empleado con el que inicia sesión el administrador
SEED_ADMIN_USERNAME=ADMIN
SEED_ADMIN_PASSWORD=<cambiar-password-admin-min-12>
SEED_ADMIN_NAME=Administrador UACH

# NestJS Observe (opcional)
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
